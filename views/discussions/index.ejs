<style>
    body {
        font-family: 'Inter', 'Arial', sans-serif;
        padding: 80px 20px 20px 20px;
        background-color: #f8f9fb;
        color: #333;
    }
  
    .topbar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 60px;
        background: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        z-index: 1000;
    }
  
    .left-section {
        display: flex;
        align-items: center;
        gap: 12px;
    }
  
    .page-title {
        font-size: 20px;
        font-weight: 600;
        color: #222;
    }
  
    header {
        max-width: 700px;
        margin: 30px auto 20px;
        text-align: right;
    }
  
    header a {
        font-size: 16px;
        font-weight: 500;
        padding: 10px 18px;
        background-color: #007bff;
        color: #fff;
        border-radius: 6px;
        text-decoration: none;
        transition: background-color 0.2s ease;
    }
  
    header a:hover {
        background-color: #0056b3;
    }
  
    ul {
        max-width: 700px;
        margin: 0 auto;
        padding: 0;
        list-style: none;
    }
  
    li {
        background: #ffffff;
        padding: 16px 20px;
        margin-bottom: 12px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        display: flex;
        flex-direction: column;
        gap: 4px;
        transition: box-shadow 0.2s ease;
    }
  
    li:hover {
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
    }
  
    li a {
        font-size: 17px;
        font-weight: 600;
        color: #007bff;
        text-decoration: none;
    }
  
    li a:hover {
        text-decoration: underline;
    }
  
    li span {
        font-size: 14px;
        color: #666;
    }
  </style>
  
  <div class="topbar">
    <div class="left-section">
        <%- include('../partials/burger-nav') %>
        <span class="page-title">Discussions</span>
    </div>
  </div>
  
  <header>
    <a href="/discussions/new">Start a new discussion</a>
  </header>
  
  <ul>
    <% discussions.forEach(d => { %>
      <li>
        <a href="/discussions/<%= d._id %>"><%= d.title %></a>
        <span>by <%= d.author.username %></span>
      </li>
    <% }) %>
  </ul>
  