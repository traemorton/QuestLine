<style>
    body {
      font-family: 'Inter', 'Segoe UI', sans-serif;
      background-color: #f8fafc;
      margin: 0;
      padding-top: 80px;
    }
  
    .topbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 70px;
      background: #ffffff;
      display: flex;
      align-items: center;
      padding: 0 25px;
      box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
      z-index: 1000;
    }
  
    .left-section {
      display: flex;
      align-items: center;
      gap: 15px;
    }
  
    .page-title {
      font-size: 20px;
      font-weight: 600;
      color: #111827;
      margin-top: 5px;
    }
  
    header {
      text-align: center;
      margin-bottom: 30px;
    }
  
    header h1 {
      font-size: 2rem;
      color: #1f2937;
      margin-bottom: 0.5rem;
    }
  
    .content-container {
      max-width: 800px;
      margin: auto;
      background: #ffffff;
      padding: 30px 40px;
      border-radius: 12px;
      box-shadow: 0px 6px 12px rgba(0,0,0,0.05);
    }
  
    .content-container p {
      font-size: 17px;
      line-height: 1.7;
      color: #374151;
      margin-bottom: 20px;
    }
  
    .meta-info {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 30px;
    }
  
    h3 {
      font-size: 1.5rem;
      color: #111827;
      margin-bottom: 15px;
    }
  
    ul.comments-list {
      list-style: none;
      padding: 0;
      margin-bottom: 40px;
    }
  
    ul.comments-list li {
      background: #f1f5f9;
      padding: 15px 20px;
      border-radius: 8px;
      margin-bottom: 10px;
      color: #374151;
    }
  
    ul.comments-list li strong {
      display: block;
      font-size: 15px;
      color: #1f2937;
      margin-bottom: 4px;
    }
  
    form {
      margin-top: 20px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
  
    textarea {
      width: 100%;
      min-height: 120px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      padding: 12px;
      font-size: 15px;
      resize: vertical;
      outline: none;
      transition: border-color 0.2s;
    }
  
    textarea:focus {
      border-color: #3b82f6;
    }
  
    button {
      align-self: flex-end;
      background-color: #3b82f6;
      color: white;
      border: none;
      border-radius: 8px;
      padding: 10px 20px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s;
    }
  
    button:hover {
      background-color: #2563eb;
    }
  </style>
  
  <div class="topbar">
    <div class="left-section">
      <%- include('../partials/burger-nav') %>
      <span class="page-title"><%= discussion.title %></span>
    </div>
  </div>
  
  <header>
    <h1><%= discussion.title %></h1>
  </header>
  
  <div class="content-container">
    <p><%= discussion.content %></p>
    <p class="meta-info">Posted by <%= discussion.author.username %> at <%= discussion.createdAt.toLocaleString() %></p>
  
    <h3>Comments</h3>
    <ul class="comments-list">
      <% discussion.comments.forEach(c => { %>
        <li>
          <strong><%= c.author?.username || 'Unknown' %>:</strong>
          <span><%= c.content %></span><br/>
          <small style="color: #6b7280;"><%= c.createdAt.toLocaleString() %></small>
        </li>
      <% }) %>
    </ul>
  
    <form action="/discussions/<%= discussion._id %>/comments" method="POST">
      <textarea name="comment" placeholder="Write your comment here..." required></textarea>
      <button type="submit">Add Comment</button>
    </form>
  </div>
  