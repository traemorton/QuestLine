<style>
  body {
    font-family: 'Inter', 'Segoe UI', sans-serif;
    background-color: #f8fafc;
    margin: 0;
    padding-top: 80px;
  }

  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background: #ffffff;
    display: flex;
    align-items: center;
    padding: 0 25px;
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
    z-index: 1000;
  }

  .left-section {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .page-title {
    font-size: 20px;
    font-weight: 600;
    color: #111827;
    margin-top: 5px;
  }

  .content-container {
    max-width: 600px;
    margin: 40px auto;
    background: #ffffff;
    padding: 30px 40px;
    border-radius: 12px;
    box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.05);
  }

  h1 {
    font-size: 1.8rem;
    color: #111827;
    text-align: center;
    margin-bottom: 25px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  label {
    font-weight: 600;
    font-size: 15px;
    color: #374151;
  }

  input[type="text"],
  textarea {
    width: 100%;
    padding: 12px;
    font-size: 15px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    outline: none;
    transition: border-color 0.2s;
    background-color: #f9fafb;
  }

  input[type="text"]:focus,
  textarea:focus {
    border-color: #3b82f6;
    background-color: #ffffff;
  }

  textarea {
    min-height: 150px;
    resize: vertical;
  }

  .buttons-container {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }

  button {
    background-color: #3b82f6;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  button:hover {
    background-color: #2563eb;
  }

  .cancel-btn {
    background-color: #d1d5db;
    color: #111827;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s;
    text-decoration: none;
  }

  .cancel-btn:hover {
    background-color: #a1a1a1;
  }

  .error-message {
    margin-top: 20px;
    padding: 12px 18px;
    background-color: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fecaca;
    border-radius: 8px;
    font-size: 14px;
  }
</style>

<div class="topbar">
  <div class="left-section">
    <%- include('../partials/burger-nav') %>
    <span class="page-title">New Discussion</span>
  </div>
</div>

<div class="content-container">
  <h1>Start a New Discussion</h1>

  <form action="/discussions" method="POST">
    <div>
      <label for="title">Title</label>
      <input type="text" id="title" name="title" placeholder="Enter a catchy title..." required />
    </div>

    <div>
      <label for="content">Content</label>
      <textarea id="content" name="content" placeholder="Share your thoughts..." required></textarea>
    </div>

    <div class="buttons-container">
      <a href="/discussions" class="cancel-btn">Cancel</a>
      <button type="submit">Post Discussion</button>
    </div>
  </form>

  <% if (errorMessage) { %>
    <div class="error-message">
      <%= errorMessage %>
    </div>
  <% } %>
</div>
