<h1>New Discussion</h1>
<form action="/discussions" method="POST">
  <label>Title:</label>
  <input type="text" name="title" required />
  <label>Content:</label>
  <textarea name="content" required></textarea>
  <button type="submit">Post</button>
</form>
<% if (errorMessage) { %><p><%= errorMessage %></p><% } %>
