<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.name %>'s Profile</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
            margin: 0;
            height: 100vh;
        }

        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            z-index: 1000;
        }

        .left-section {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .page-title {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            margin-left: 10px;
            margin-top: 8px;
        }

        .profile-container {
            padding: 20px;
            border: 1px solid #ddd;
            background-color: #f9f9f9;
            border-radius: 8px;
            max-width: 500px;
            margin: auto;
            text-align: center;
            margin-top: 80px;
        }

        .profile-pic {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
        }

        .info {
            margin-top: 10px;
            font-size: 18px;
            color: #555;
        }

        /* Button Styling */
        .edit-profile-btn {
            margin-top: 40px;
            padding: 10px 20px;
            background-color: #007BFF;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            text-decoration: none;
        }

        .edit-profile-btn:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <div class="topbar">
        <div class="left-section">
            <%- include('partials/burger-nav') %>
            <span class="page-title">Profile</span>
        </div>
        <%- include('partials/profile-header', { user: user }) %>
    </div>    

    <div class="profile-container">
        <h1><%= user.name %>'s Profile</h1>
        <img class="profile-pic" src="<%= user.profilePicture %>" alt="Profile Picture">
        <p class="info"><strong>Username:</strong> <%= user.username %></p>
        <p class="info"><strong>Email:</strong> <%= user.email %></p>
        <p class="info"><strong>Bio:</strong> <%= user.bio || 'No bio available' %></p>
        <p class="info"><strong>Role:</strong> <%= user.role %></p>
        <p class="info"><strong>Location:</strong> <%= user.location %></p>
        <p class="info"><strong>Last Login:</strong> <%= user.lastLogin.toDateString() %></p>
        <p class="info"><strong>Account Created:</strong> <%= user.accountCreated.toDateString() %></p>

        <!-- Edit Profile Button -->
        <a href="/edit-profile" class="edit-profile-btn">Edit Profile</a>
    </div>
</body>
</html>
