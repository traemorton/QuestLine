<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= group.name %></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
            padding-top: 50px;
        }
        h1 {
            color: #333;
        }
        .container {
            padding: 20px;
            border: 1px solid #ddd;
            background-color: #f9f9f9;
            border-radius: 8px;
            max-width: 500px;
            margin: auto;
            text-align: center;
        }
        .profile-pic {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 10px;
        }
        .info {
            margin-top: 10px;
            font-size: 18px;
            color: #555;
        }
        .logout-btn {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 15px;
            color: white;
            background-color: #dc3545;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
        }
        .logout-btn:hover {
            background-color: #c82333;
        }
        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            z-index: 1000;
        }
        /* New Left Section (Burger + Page Title) */
        .left-section {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        /* Fix title alignment */
        .page-title {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            margin-left: 10px;
            margin-top: 8px;
        }
    </style>
</head>
<body>
    <h1><%= group.name %></h1>
    <p><strong>Description:</strong> <%= group.description %></p>
    
    <h3>Members:</h3>
    <ul>
        <% group.members.forEach(member => { %>
            <li><%= member.name %> (<%= member.username %>)</li>
        <% }) %>
        
    </ul>

    <form action="/groups/<%= group._id %>/leave" method="POST">
        <button type="submit">Leave Group</button>
    </form>

    <a href="/groups">Back to all groups</a>
</body>
</html>
