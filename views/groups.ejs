<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Groups</title>
    <link rel="stylesheet" href="/styles.css"> <!-- Optional external styling -->
</head>
<body>
    <header>
        <div style="margin-bottom: 20px;">
            <a href="/groups/new" class="btn btn-primary">➕ Create New Group</a>
        </div>
    </header>

    <main class="container">
        <h1>Groups</h1>

        <% if (groups.length === 0) { %>
            <p>No groups found.</p>
        <% } else { %>
            <ul class="group-list">
                <% groups.forEach(group => { %>
                    <li class="group-item">
                        <article>
                            <h2><%= group.name %></h2>
                            <p><%= group.description %></p>

                            <% if (typeof currentUser !== 'undefined' && currentUser && currentUser._id) { %>
                                <% const isMember = group.members.some(member => member._id.toString() === currentUser._id.toString()); %>

                                <% if (!isMember) { %>
                                    <form action="/groups/<%= group._id %>/join" method="POST">
                                        <button type="submit" class="btn btn-join">Join Group</button>
                                    </form>
                                <% } else { %>
                                    <p class="member-note">✅ You are a member</p>
                                    <!-- Add a form to leave the group -->
                                    <form action="/groups/<%= group._id %>/leave" method="POST">
                                        <button type="submit" class="btn btn-leave">Leave Group</button>
                                    </form>
                                <% } %>
                            <% } else { %>
                                <p><em>Log in to join or leave this group.</em></p>
                            <% } %>
                        </article>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </main>
</body>
</html>
