<%# burger-nav.ejs %>

<style>
  /* Burger Menu icon */
  .burger-menu {
      display: block;
      cursor: pointer;
      font-size: 30px;
      padding: 5px;
      background: none;
      border: none;
      color: #333;
  }

  /* Navigation menu for the burger */
  .burger-menu-items {
      position: fixed;
      top: 0;
      left: -100%;
      width: 250px;
      height: 100vh;
      background-color: #fff;
      border-right: 1px solid #ccc;
      box-shadow: 4px 0px 8px rgba(0, 0, 0, 0.1);
      transition: left 0.3s ease-in-out;
      z-index: 1000;
      padding: 20px;
      border-radius: 0 10px 10px 0;
  }

  .burger-menu-items a {
      display: block;
      padding: 10px;
      text-decoration: none;
      color: #333;
      margin: 5px 0;
      border-radius: 4px;
  }

  .burger-menu-items a:hover {
      background-color: #f0f0f0;
  }

  .categories {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 10px;
      /* border-bottom: 1px solid #ccc; */
      position: relative;
  }

  /* Close button */
  .burger-close-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 18px;
      color: #333;
      cursor: pointer;
      background: none;
      border: none;
  }

  .burger-close-btn:hover {
      color: #f00;
  }

  /* Overlay */
  .overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      display: none;
      z-index: 999;
  }
</style>

<!-- Burger Menu Icon -->
<button class="burger-menu" id="burger-menu">&#9776;</button>

<!-- Overlay -->
<div class="overlay" id="overlay"></div>

<!-- Burger Navigation Menu -->
<div class="burger-menu-items" id="burger-menu-items">
  <div class="categories">
    <button class="burger-close-btn" id="burger-close-btn">&times;</button>
  </div>
  <hr style="margin: 20px 0; border: none;">
  <a href="/dashboard">Home</a>
  <a href="/issues">Issues</a>
  <a href="/projects">Projects</a>
  <a href="/discussions">Discussions</a>
  <a href="/explore">Explore</a>
  <hr style="margin: 20px 0; border: none; border-top: 1px solid #ccc;">
  <a href="/about">About</a>
  <a href="/contact">Contact</a>
  <a href="/services">Services</a>
  <hr style="margin: 20px 0; border: none; border-top: 1px solid #ccc;">
  <a href="/users">Users</a>
  <a href="/groups">Groups</a>
</div>

<!-- JS -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const burgerMenu = document.getElementById('burger-menu');
    const burgerMenuItems = document.getElementById('burger-menu-items');
    const burgerCloseBtn = document.getElementById('burger-close-btn');
    const overlay = document.getElementById('overlay');

    function openBurgerMenu() {
      burgerMenuItems.style.left = '0';
      overlay.style.display = 'block';
    }

    function closeBurgerMenu() {
      burgerMenuItems.style.left = '-100%';
      overlay.style.display = 'none';
    }

    burgerMenu.addEventListener('click', () => {
      const isOpen = getComputedStyle(burgerMenuItems).left === '0px';
      isOpen ? closeBurgerMenu() : openBurgerMenu();
    });

    burgerCloseBtn.addEventListener('click', closeBurgerMenu);
    overlay.addEventListener('click', closeBurgerMenu);
  });
</script>
